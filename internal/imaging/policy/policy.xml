<?xml version="1.0" encoding="UTF-8"?>
<!--
  ImageMagick security policy for Mayuri2000 (loaded via MAGICK_CONFIGURE_PATH).
  Defence in depth behind the forced input coder (InputSpec), escapeText and
  the decoder sandbox: only the formats the effects use are allowed.
-->
<policymap>
  <policy domain="resource" name="memory" value="512MiB"/>
  <policy domain="resource" name="map" value="1GiB"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="time" value="150"/>
  <!-- No external programs (ghostscript, ffmpeg, curl, ...). -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <!-- No "@file" indirect reads in any argument. -->
  <policy domain="path" rights="none" pattern="@*"/>
  <!-- Deny every coder, then allow what the effects use. -->
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{PNG,GIF,JPEG,JPG,WEBP}"/>
  <policy domain="coder" rights="read" pattern="{CAPTION,NULL}"/>
</policymap>
