# Copy to .env and fill in. Lines starting with # are ignored.

# Required: the bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Default text prefix; servers can override it with /prefix.
BOT_PREFIX=%

# Register slash commands only in these servers (comma-separated IDs) for
# instant updates while testing. Leave empty to register them globally.
DEV_GUILD_IDS=

# Optional API keys.
TENOR_API_KEY=
GENIUS_TOKEN=

# How often RSS feeds are checked (minimum 1m).
RSS_INTERVAL=5m

# debug, info, warn or error.
LOG_LEVEL=info

# Decoder sandbox for ImageMagick/ffmpeg: "required" (default) disables image
# and video effects if it can't be fully applied; "best-effort" runs them with
# whatever the kernel supports.
# DECODER_SANDBOX=required

# Already set by the image; only change these if you know you need to.
# DATABASE_PATH=/data/mayuri.db
# MAGICK_PATH=magick
# FFMPEG_PATH=ffmpeg
